# Copy to .env and change every secret. Never commit .env.
# ---------------- PostgreSQL ----------------
POSTGRES_HOST=localhost            # docker-compose overrides this with "postgres" inside containers
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432            # host port published by docker compose
POSTGRES_DB=retail_supply_chain
POSTGRES_USER=control_tower
POSTGRES_PASSWORD=change-me-strong-password
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/retail_supply_chain   # optional override

# ---------------- Data source ----------------
DATA_SOURCE=kaggle                 # kaggle = data/raw (real Olist) | sample = data/sample (synthetic demo)
KAGGLE_USERNAME=
KAGGLE_KEY=
FORCE_RELOAD=false

# ---------------- Simulation (SYNTHETIC operational data) ----------------
SIMULATION_RANDOM_SEED=42
SIM_N_PRODUCTS=300
SIM_N_SUPPLIERS=25
SIM_BOOTSTRAP_HOURS=336
SIM_DEMAND_LOOKBACK_DAYS=90
SIM_LOW_STOCK_SHARE=0.12
SIM_DISRUPTION_PROB=0.08

# ---------------- Inventory policy ----------------
INV_SERVICE_LEVEL=0.95
INV_REVIEW_PERIOD_DAYS=7
INV_WARNING_BUFFER=0.20
INV_DEMAND_WINDOW_DAYS=90
INV_MIN_ORDER_QTY=1

# ---------------- Anomaly detection ----------------
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_Z_WINDOW=28
ANOMALY_IFOREST_CONTAMINATION=0.01
SUPPLIER_LEAD_TIME_THRESHOLD_DAYS=14
DEPLETION_RATIO_THRESHOLD=2.5

# ---------------- Forecasting ----------------
FORECAST_HOLDOUT_DAYS=30
FORECAST_TRAIN_START=2017-01-01
FORECAST_TOP_N_CATEGORIES=10
FORECAST_TOP_N_PRODUCTS=20
FORECAST_REFRESH_HOURS=24

# ---------------- Alerts ----------------
ALERT_MODE=local                   # local | slack | email | all
ALERT_MIN_SEVERITY=HIGH
ALERT_COOLDOWN_HOURS=24
ALERT_MAX_INDIVIDUAL=10
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---------------- Airflow ----------------
AIRFLOW_UID=50000                  # on Linux set to $(id -u)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-long-random-string
AIRFLOW_FERNET_KEY=

# ---------------- Superset ----------------
SUPERSET_SECRET_KEY=change-me-another-long-random-string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset
SUPERSET_URL=http://localhost:8088
SUPERSET_ANALYTICS_DB_URI=postgresql+psycopg2://control_tower:change-me-strong-password@postgres:5432/retail_supply_chain

LOG_LEVEL=INFO
